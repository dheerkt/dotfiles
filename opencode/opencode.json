{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "glm-5.1": { "name": "GLM-5.1" },
        "glm-5.3": { "name": "GLM-5.3" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "grok-4.5": { "name": "Grok 4.5" }
      }
    }
  },
  "agents": {
    "build": { "model": "opencode-go/deepseek-v4.1-flash" },
    "plan": { "disabled": true },
    "explore": { "model": "opencode-go/deepseek-v4.1-flash" },
    "general": { "model": "opencode-go/deepseek-v4.1-flash" },
    "code-reviewer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "overseer": { "model": "openai/gpt-6.2-sol" },
    "overseer-worker": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "overseer-worker-lite": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "review-overseer": { "model": "opencode-go/deepseek-v4.1-flash#max" },
    "deep-build": { "model": "opencode-go/deepseek-v4.1-flash#max" }
  },
  "plugins": ["@tarquinen/opencode-dcp@latest"],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["/Users/dheerkt/.bun/bin/browse", "mcp"],
        "cwd": "/Users/dheerkt",
        "pool": true,
        "environment": { "OPENCODE_BROWSER_RUNTIME": "auto-update" }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "timeout": { "catalog": 120000, "execution": 120000 }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "timeout": { "catalog": 120000, "execution": 120000 }
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "cloudflare-bindings": {
        "type": "remote",
        "url": "https://bindings.mcp.cloudflare.com/mcp"
      },
      "cloudflare-builds": {
        "type": "remote",
        "url": "https://builds.mcp.cloudflare.com/mcp"
      },
      "cloudflare-observability": {
        "type": "remote",
        "url": "https://observability.mcp.cloudflare.com/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": { "Authorization": "Bearer ctx7sk-a8757060-5562-42b5-a4a2-8a128d228440" },
        "timeout": { "catalog": 60000, "execution": 60000 }
      },
      "aws-mcp": {
        "type": "local",
        "command": [
          "/Users/dheerkt/Library/Python/3.12/bin/uvx",
          "mcp-proxy-for-aws@1.6.4",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "AWS_REGION=us-east-1"
        ],
        "timeout": { "startup": 120000, "catalog": 120000, "execution": 300000 }
      },
      "davinci-resolve": {
        "type": "local",
        "command": [
          "/Users/dheerkt/Library/Application Support/davinci-resolve-mcp/venv/bin/python",
          "/Users/dheerkt/Library/Application Support/davinci-resolve-mcp/src/server.py"
        ],
        "environment": {
          "RESOLVE_SCRIPT_API": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting",
          "RESOLVE_SCRIPT_LIB": "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Libraries/Fusion/fusionscript.so",
          "PYTHONPATH": "/Library/Application Support/Blackmagic Design/DaVinci Resolve/Developer/Scripting/Modules"
        }
      }
    }
  }
}
