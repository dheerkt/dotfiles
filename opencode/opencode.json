{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.2-codex": {
          "name": "GPT-5.2-Codex"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash"
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5"
        },
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5"
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "github-copilot/gpt-5.2-codex"
    },
    "plan": {
      "model": "github-copilot/gpt-5.2-codex"
    },
    "explore": {
      "model": "github-copilot/gemini-3-flash-preview"
    },
    "general": {
      "model": "github-copilot/gpt-5.2-codex"
    }
  },
  "plugins": ["@tarquinen/opencode-dcp@latest"],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--no-usage-statistics", "--port=9222"],
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        },
        "disabled": true
      }
    }
  }
}
