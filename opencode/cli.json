{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "cursor"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "new_location": "inherit"
  },
  "animations": true,
  "debug": {
    "devtools": true,
    "turn_tokens": false,
    "timing": false
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "vertical"
  },
  "attention": {
    "notifications": true
  }
}
